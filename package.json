{
  "name": "@ozjsey/v-copy",
  "version": "1.1.0",
  "description": "Vue 3 directive that copies any element — and keeps the last N copies so your users can pick one back out. Copy history with de-duplication, a copied-feedback state, slot-like reactive state, keyboard + a11y, and an automatic clipboard fallback. Zero dependencies.",
  "author": "Ozgur Seyidoglu",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ozJSey/vue-copy.git" },
  "homepage": "https://github.com/ozJSey/vue-copy#readme",
  "bugs": { "url": "https://github.com/ozJSey/vue-copy/issues" },
  "type": "module",
  "main": "dist/vCopy.min.js",
  "module": "dist/vCopy.min.js",
  "types": "dist/vCopy.d.ts",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/vCopy.d.ts", "import": "./dist/vCopy.min.js", "default": "./dist/vCopy.min.js" } },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup vCopy.ts --format esm --minify --dts --out-dir dist --clean && mv dist/vCopy.js dist/vCopy.min.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["vue", "vue3", "directive", "copy", "clipboard", "copy-to-clipboard", "copy-history", "clipboard-history", "clipboard-manager", "v-copy", "textcontent", "a11y"],
  "peerDependencies": { "vue": "^3.0.0" },
  "devDependencies": { "jsdom": "^25.0.0", "tsup": "^8.5.1", "typescript": "^5.5.0", "vitest": "^2.0.0", "vue": "^3.5.0" }
}
